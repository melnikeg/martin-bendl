---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const offenDenkenHref = `${baseUrl}/offen-denken/`;
---

<Layout
	title="Meine Geschichte — Martin Bendl"
	description="Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause. Ein Stück meines Weges als Papa, Freund und Herzensmensch."
>
	<img
		src={`${baseUrl}/meine-geschichte-background.png`}
		alt=""
		aria-hidden="true"
		class="pointer-events-none fixed inset-0 z-0 h-full w-full object-cover"
		fetchpriority="high"
	/>
	<Header />

	<main class="relative z-10 w-full">
		<div class="h-20 bg-[#f8f2e7] md:h-14" aria-hidden="true"></div>
		<section data-reveal-section data-reveal-delay="150" class="mt-0 mx-auto max-w-[1280px] overflow-hidden bg-[#f8f2e7] opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-10 md:rounded-md">
			<div class="relative mx-auto grid max-w-[1280px] grid-cols-[minmax(0,1fr)_auto] items-center gap-5 px-6 pb-8 pt-6 sm:gap-10 md:px-10 md:pb-10 md:pt-8 max-md:grid-cols-1 max-md:items-start max-md:gap-0 max-md:overflow-hidden max-md:px-0 max-md:pb-0 max-md:pt-0">
				<div class="relative z-10 max-md:px-6 max-md:pt-[36vh] max-md:pb-8">
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-4 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-[var(--color-olive)]">Über mich</p>
						<h1 class="mb-4 max-w-xl text-[2.4rem] font-bold leading-[1.02] tracking-tight text-[var(--color-text-primary)] sm:text-5xl md:text-6xl">
							Meine<br />Geschichte
						</h1>
						<p class="max-w-md text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">
							Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause
						</p>
					</div>
					<a
						href="#mein-weg"
						data-reveal-item="3"
						class="group mt-6 inline-flex items-center gap-2 border-b border-[var(--color-text-primary)]/30 pb-1 text-xs font-semibold text-[var(--color-olive-dark)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 hover:border-[var(--color-olive)] hover:text-[var(--color-olive)] sm:mt-8 max-md:hidden"
					>
						Ein Stück meines Weges
						<svg class="h-4 w-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M10 3.5v12m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>

				<figure data-reveal-item="1" class="justify-self-end opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 max-md:absolute max-md:inset-x-0 max-md:top-0 max-md:z-0 max-md:h-[60vh] max-md:w-full">
					<img
						src={`${baseUrl}/martin-bendl.png`}
						alt="Martin Bendl lächelt in die Kamera"
						class="aspect-[0.82] w-[clamp(8.125rem,24vw,17rem)] object-cover object-center max-md:h-full max-md:w-full max-md:max-w-none max-md:aspect-auto max-md:object-center"
						width="580"
						height="683"
						fetchpriority="high"
					/>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#f8f2e7] md:hidden" aria-hidden="true"></div>
					<figcaption class="mt-2 text-center text-[0.6rem] text-[var(--color-text-muted)] max-md:hidden">
						Martin · daheim im Woid
					</figcaption>
				</figure>
			</div>
		</section>

		<section id="mein-weg" data-reveal-section class="mx-auto mt-0 max-w-[1280px] scroll-mt-20 bg-[#f8f2e7] px-6 pb-12 pt-8 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:px-10 md:pb-16 md:pt-12">
			<article class="mx-auto max-w-[36rem]">
				<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
					<p class="mb-6 text-[0.85rem] leading-[1.65] text-[var(--color-text-secondary)] sm:text-base">
						Ich bin Martin Bendl. Papa, Freund, Herzensmensch und jemand, der gerne ein bisschen genauer hinhört.
					</p>
					<h2 class="mb-6 font-serif text-[1.45rem] leading-[1.2] text-[var(--color-text-primary)] sm:text-[1.75rem]">
						Ich weiß, wie es ist, einen geliebten Menschen zu verlieren und am nächsten Morgen wieder als Papa gebraucht zu werden.
					</h2>
				</div>
				<div data-reveal-item="3" class="space-y-4 text-[0.82rem] leading-[1.65] text-[var(--color-text-secondary)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 sm:text-sm">
					<p>
						Heute bin ich alleinerziehender Vater einer wunderbaren Tochter. Unser Alltag ist ein anderer geworden. Vieles, was vorher selbstverständlich war, darf nach und nach einen neuen Platz finden. Dabei dürfen auch meine eigenen Wünsche und Pläne wieder Raum bekommen. Und der Blick nach vorne darf offen bleiben für das, was noch kommt.
					</p>
					<p class="font-semibold leading-relaxed text-[var(--color-olive-dark)]">
						Mittendrin meine Tochter.<br />
						Ihre Kindheit findet jetzt statt.
					</p>
					<p>
						Mir ist wichtig, sie groß werden zu sehen und mitzubekommen, was sie beschäftigt und welche Fragen sie gerade hat. Bei aller Verantwortung und den ganz normalen Alltagssorgen gibt es zum Glück immer wieder etwas zu lachen. Oft sind es die ganz gewöhnlichen Tage, an die ich mich gerne erinnere.
					</p>
					<p>
						Meine Familie gehört zum Wertvollsten in meinem Leben. Ich bin ein Familienmensch. Gemeinsame Zeit bedeutet mir viel. Auch meine Freunde dürfen auf mich zählen, wenn sie ein offenes Ohr brauchen oder ich mit anpacken kann.
					</p>
					<p>
						Ich habe eine Ausbildung zum Schreiner absolviert und später 16 Jahre im Außendienst als Qualitätsmanager für ein Schweizer Unternehmen gearbeitet. Im Handwerk habe ich gelernt, genau hinzuschauen und präzise zu arbeiten. Besonders in Erinnerung geblieben sind mir die vielen Begegnungen mit Menschen aus unterschiedlichen Ländern.
					</p>
					<p>
						Auch die Kampfkunst hat mich über viele Jahre begleitet. Dort habe ich Disziplin, Respekt und Verantwortung gelernt und erfahren, wie wichtig der Zusammenhalt im Team ist.
					</p>
					<p class="pt-2 font-semibold text-[var(--color-text-primary)]">
						Menschen und ihre Geschichten interessieren mich.
					</p>
					<p>
						Ich mag Gespräche mit Tiefe, in denen auch Gedanken Platz haben, die noch nicht fertig sortiert sind. Fragen, auf die es nicht sofort eine Antwort gibt. Dabei ist mir wichtig, aufmerksam zuzuhören und meinem Gegenüber Zeit zu lassen, die eigenen Worte zu finden. Und manchmal tut es einfach gut, gemeinsam über das Chaos des Lebens zu lachen.
					</p>
				</div>
			</article>
		</section>

		<!-- ===== NATUR UND FOTOGRAFIE: WOIDSTRAWANZA ===== -->
		<section data-reveal-section class="mx-auto mt-32 max-w-[1280px] bg-[#eee5d3] px-6 py-12 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:py-14">
			<div class="mx-auto grid max-w-[1280px] items-center gap-8 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:px-10">
				<div>
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-3 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-olive)]">Natur und Fotografie</p>
						<h2 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
							Woidstrawanza
						</h2>
						<p class="mb-5 font-serif text-xl text-[var(--color-olive-dark)]">Draußen bekomme ich den Kopf frei</p>
					</div>
					<div data-reveal-item="3" class="space-y-4 text-[0.8rem] leading-[1.65] text-[var(--color-text-secondary)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 sm:text-sm">
						<p>
							Mich zieht es in die Wälder und Berge meiner Heimat. Zum Wandern oder aufs Radl. Und genauso gerne nehme ich dabei die Kamera in die Hand.
						</p>
						<p>
							Ich fotografiere meine Heimat von Herzen gern. Landschaften, Stimmungen, besondere Momente und genau die kleinen Details, an denen man sonst vielleicht einfach vorbeigehen würde. Für mich bedeutet Fotografie, einen Moment bewusst wahrzunehmen und festzuhalten.
						</p>
						<p>
							Viele dieser Bilder und Einblicke findest du auf Instagram unter @woidstrawanza.
						</p>
						<a
							href="https://www.instagram.com/woidstrawanza"
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex items-center gap-1 border-b border-[var(--color-text-primary)]/30 pb-1 text-xs font-semibold text-[var(--color-olive-dark)] hover:border-[var(--color-olive)] hover:text-[var(--color-olive)]"
						>
							@woidstrawanza
							<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M5 11 11 5M5.5 5H11v5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					</div>
				</div>
				<figure data-reveal-item="1" class="overflow-hidden rounded-xl shadow-md opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
					<img
						src={`${baseUrl}/meine-geschichte/woidstrawanza.jpg`}
						alt="Natur und Fotografie im Bayerischen Wald"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</figure>
			</div>
		</section>

		<!-- ===== PODCAST UND GESPRÄCHE: UNTER UNS G'SOGT ===== -->
		<section data-reveal-section class="mx-auto mt-32 max-w-[1280px] bg-[#f8f2e7] px-6 py-12 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:py-14">
			<div class="mx-auto grid max-w-[1280px] items-center gap-8 md:grid-cols-[0.9fr_1.1fr] md:gap-14 md:px-10">
				<figure data-reveal-item="1" class="order-2 overflow-hidden rounded-xl shadow-md opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:order-1">
					<img
						src={`${baseUrl}/meine-geschichte/unter-uns-gsogt.jpg`}
						alt="Podcast-Mikrofone für den Podcast Unter uns g'sogt"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</figure>
				<div class="order-1 md:order-2">
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-3 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-olive)]">Podcast und Gespräche</p>
						<h2 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
							Unter uns g’sogt
						</h2>
						<p class="mb-5 font-serif text-xl text-[var(--color-olive-dark)]">Meine Heimat hört man mir übrigens an</p>
					</div>
					<div data-reveal-item="3" class="space-y-4 text-[0.8rem] leading-[1.65] text-[var(--color-text-secondary)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 sm:text-sm">
						<p>
							Ich spreche bayerisch, wie mir der Schnabel gewachsen ist. Genau so darf man mich auch im Podcast „Unter uns g’sogt“ erleben. Meine Podcastpartnerin Jetti und ich reden über Liebe, Beziehungen und Zweifel. Auch Traurigkeit und Einsamkeit gehören dazu.
						</p>
						<p>
							Als „LebensExperten“ erzählen wir aus unserem eigenen Leben. Bayerischer Real Talk. Persönlich. Direkt. Ehrlich. Und mit einer guten Portion Humor.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== GEDANKEN TEILEN: HERZ.ENSMENSCHEN ===== -->
		<section data-reveal-section class="mx-auto mt-32 max-w-[1280px] bg-[#eee5d3] px-6 py-12 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:py-14">
			<div class="mx-auto grid max-w-[1280px] items-center gap-8 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:px-10">
				<div>
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-3 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-olive)]">Gedanken teilen</p>
						<h2 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
							Herz.ensmenschen
						</h2>
						<p class="mb-5 font-serif text-xl text-[var(--color-olive-dark)]">Sprüche und Zitate voller Herz und Tiefe</p>
					</div>
					<div data-reveal-item="3" class="space-y-4 text-[0.8rem] leading-[1.65] text-[var(--color-text-secondary)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 sm:text-sm">
						<p>
							Auf meinem Instagram-Profil @herz.ensmenschen teile ich Gedanken über Liebe, Beziehungen und das Miteinander. Meine Beiträge sollen berühren, zum Nachdenken anregen und manchmal genau die Worte finden, die einem selbst gerade fehlen.
						</p>
						<a
							href="https://www.instagram.com/herz.ensmenschen"
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex items-center gap-1 border-b border-[var(--color-text-primary)]/30 pb-1 text-xs font-semibold text-[var(--color-olive-dark)] hover:border-[var(--color-olive)] hover:text-[var(--color-olive)]"
						>
							@herz.ensmenschen
							<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M5 11 11 5M5.5 5H11v5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					</div>
				</div>
				<figure data-reveal-item="1" class="overflow-hidden rounded-xl shadow-md opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
					<img
						src={`${baseUrl}/meine-geschichte/herzensmenschen.jpg`}
						alt="Notizbuch und Stift für Gedanken und Zitate"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</figure>
			</div>
		</section>

		<!-- ===== ENGAGEMENT IN DER HEIMAT: BAYERWALD AWARD ===== -->
		<section data-reveal-section class="mx-auto mt-32 max-w-[1280px] bg-[#f8f2e7] px-6 py-12 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:py-14">
			<div class="mx-auto grid max-w-[1280px] items-center gap-8 md:grid-cols-[0.9fr_1.1fr] md:gap-14 md:px-10">
				<figure data-reveal-item="1" class="order-2 overflow-hidden rounded-xl shadow-md opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:order-1">
					<img
						src={`${baseUrl}/meine-geschichte/bayerwald-award.jpg`}
						alt="Trophäe des Bayerwald Awards"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</figure>
				<div class="order-1 md:order-2">
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-3 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-olive)]">Engagement in der Heimat</p>
						<h2 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
							Bayerwald Award
						</h2>
						<p class="mb-5 font-serif text-xl text-[var(--color-olive-dark)]">Der große Preis des Bayerischen Waldes</p>
					</div>
					<div data-reveal-item="3" class="space-y-4 text-[0.8rem] leading-[1.65] text-[var(--color-text-secondary)] opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 sm:text-sm">
						<p>
							Als Koordinator im Organisationsstab und Juryleiter beim Bayerwald Award darf ich Menschen kennenlernen, die unsere Heimat mit ihren Ideen, ihrer Leidenschaft und ihrem Engagement prägen. Ihre Geschichten sichtbar zu machen und ihren Einsatz zu würdigen, liegt mir besonders am Herzen. Denn unsere Heimat lebt von den Menschen, die hier etwas bewegen.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== OFFEN DENKEN: PERSÖNLICHES SPARRING ===== -->
		<section data-reveal-section class="mx-auto mt-32 mb-32 max-w-[1280px] bg-[#e4e4cc] px-6 py-12 opacity-0 -translate-x-12 max-md:-translate-x-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0 md:mt-32 md:rounded-md md:py-14">
			<div class="mx-auto grid max-w-[1280px] items-center gap-8 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:px-10">
				<div>
					<div data-reveal-item="2" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<p class="mb-3 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-olive)]">Offen Denken</p>
						<h2 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
							Persönliches Sparring für emotionale Klarheit
						</h2>
						<p class="mb-5 font-serif text-xl text-[var(--color-olive-dark)]">Jemand, der sich Zeit nimmt und dir zuhört</p>
					</div>
					<div data-reveal-item="3" class="opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
						<div class="space-y-4 text-[0.8rem] leading-[1.65] text-[var(--color-text-secondary)] sm:text-sm">
						<p>
							Aus meiner Freude an echten Gesprächen ist „Offen Denken“ entstanden. Für Menschen, die ihre Gedanken sortieren, offen reden oder eine neue Perspektive gewinnen möchten.
						</p>
						<p>
							Manchmal tut es gut, mit jemanden zu sprechen, der nicht Teil der eigenen Geschichte ist. Ich höre dir zu, frage nach und bringe einen Blick von außen mit. Wie ein persönliches Sparring mit mir abläuft, erfährst du auf „Offen Denken“.
						</p>
						<p class="font-semibold text-[var(--color-text-primary)]">
							Was beschäftigt dich gerade, dass du bisher mit dir allein ausmachst?
						</p>
					</div>
					<a
						href={offenDenkenHref}
						class="group mt-6 inline-flex w-fit items-center gap-3 rounded-full bg-[var(--color-olive)] px-5 py-3 text-xs font-semibold text-white transition-colors hover:bg-[var(--color-olive-dark)]"
					>
						Offen Denken entdecken
						<svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
					</div>
				</div>
				<figure data-reveal-item="1" class="overflow-hidden rounded-xl shadow-md opacity-0 translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:opacity-100 motion-reduce:translate-x-0">
					<img
						src={`${baseUrl}/meine-geschichte/offen-denken-sparring.jpg`}
						alt="Ruhiger Gesprächsraum mit Blick in den Wald"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</figure>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	const revealClasses = ['opacity-0', 'translate-x-8', '-translate-x-12', 'max-md:-translate-x-6'];
	const show = (el: Element | null) => {
		el?.classList.remove(...revealClasses);
	};

	const sections = document.querySelectorAll<HTMLElement>('[data-reveal-section]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReducedMotion) {
		sections.forEach((section) => {
			show(section);
			section.querySelectorAll('[data-reveal-item]').forEach(show);
		});
	} else {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;

					const section = entry.target as HTMLElement;
					obs.unobserve(section);

					const baseDelay = Number(section.dataset.revealDelay ?? 300);
					setTimeout(() => show(section), baseDelay);

					const items = Array.from(section.querySelectorAll<HTMLElement>('[data-reveal-item]')).sort(
						(a, b) => Number(a.dataset.revealItem) - Number(b.dataset.revealItem)
					);

					items.forEach((item, index) => {
						setTimeout(() => show(item), baseDelay + 300 + index * 200);
					});
				});
			},
			{ threshold: 0.05 }
		);

		sections.forEach((section) => observer.observe(section));
	}
</script>
