---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
	title="Impressum — Martin Bendl"
	description="Impressum und rechtliche Angaben gemäß § 5 DDG und § 18 Abs. 2 MStV für die Website von Martin Bendl."
>
	<Header />

	<main class="w-full pt-20 md:pt-14">
		<section class="mx-auto max-w-[1280px] px-6 py-10 md:px-10 md:py-14">
			<div class="mx-auto max-w-2xl md:mt-6">
				<p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-olive)]">
					Rechtliche Hinweise
				</p>
				<h1 class="mb-8 text-4xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-5xl md:text-6xl">
					Impressum
				</h1>

				<div class="space-y-8 text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">
					<!-- 1. Angaben gemäß § 5 DDG -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Angaben gemäß § 5 DDG (Digitale-Dienste-Gesetz)
						</h2>
						<p class="text-[var(--color-text-primary)] font-medium">
							Martin Bendl<br />
							[Straße und Hausnummer]<br />
							[PLZ und Ort]<br />
							Deutschland
						</p>
					</section>

					<!-- 2. Kontakt -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Kontakt
						</h2>
						<p>
							<span class="font-medium text-[var(--color-text-primary)]">Telefon:</span> [Telefonnummer]<br />
							<span class="font-medium text-[var(--color-text-primary)]">E-Mail:</span> 
							<a href="mailto:kontakt@martin-bendl.de" class="text-[var(--color-olive-dark)] hover:underline font-medium">
								kontakt@martin-bendl.de
							</a><br />
							<span class="font-medium text-[var(--color-text-primary)]">Website:</span> 
							<a href="https://unter-uns-gsogt.podigee.io" target="_blank" rel="noopener noreferrer" class="text-[var(--color-olive-dark)] hover:underline">
								unter-uns-gsogt.podigee.io
							</a>
						</p>
					</section>

					<!-- 3. Berufsbezeichnung & Abgrenzung -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Berufsbezeichnung und berufsrechtliche Hinweise
						</h2>
						<p>
							<span class="font-medium text-[var(--color-text-primary)]">Tätigkeitsbezeichnung:</span> Freier Berater / Psychologischer Berater (verliehen in der Bundesrepublik Deutschland).
						</p>
						<p class="text-xs sm:text-sm italic">
							<strong class="font-semibold text-[var(--color-text-primary)]">Hinweis:</strong> Die im Rahmen von <em>Offen Denken</em> angebotenen Gespräche und Beratungen stellen keine Psychotherapie oder heilkundliche Behandlung im Sinne des Psychotherapeutengesetzes oder des Heilpraktikergesetzes dar. Es werden weder Diagnosen gestellt noch Heilungsversprechen abgegeben.
						</p>
					</section>

					<!-- 4. Umsatzsteuer -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Umsatzsteuer
						</h2>
						<p>
							Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz (UStG):<br />
							<em>[USt-IdNr., z. B. DE123456789 oder: Gemäß § 19 UStG wird keine Umsatzsteuer berechnet (Kleinunternehmerstatus).]</em>
						</p>
					</section>

					<!-- 5. Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Verantwortlich für redaktionelle Inhalte gemäß § 18 Abs. 2 MStV
						</h2>
						<p class="text-[var(--color-text-primary)]">
							Martin Bendl<br />
							[Straße und Hausnummer]<br />
							[PLZ und Ort]
						</p>
					</section>

					<!-- 6. Verbraucherstreitbeilegung -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							EU-Streitschlichtung und Verbraucherstreitbeilegung
						</h2>
						<p>
							Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit: 
							<a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-olive-dark)] underline break-all">
								https://ec.europa.eu/consumers/odr/
							</a>.<br />
							Unsere E-Mail-Adresse finden Sie oben im Impressum.
						</p>
						<p>
							Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
						</p>
					</section>

					<!-- 7. Haftung für Inhalte & Links -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Haftung für Inhalte und Links
						</h2>
						<p>
							Als Diensteanbieter sind wir gemäß § 7 Abs. 1 DDG für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 DDG sind wir als Diensteanbieter jedoch nicht verpflichtet, übermittelte oder gespeicherte fremde Informationen zu überwachen oder nach Umständen zu forschen, die auf eine rechtswidrige Tätigkeit hinweisen.
						</p>
						<p>
							Unser Angebot enthält Links zu externen Websites Dritter (u. a. Podigee, Instagram, Facebook), auf deren Inhalte wir keinen Einfluss haben. Deshalb können wir für diese fremden Inhalte auch keine Gewähr übernehmen. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber der Seiten verantwortlich.
						</p>
					</section>

					<!-- 8. Urheberrecht -->
					<section class="space-y-3">
						<h2 class="text-xl font-bold text-[var(--color-text-primary)]">
							Urheberrecht
						</h2>
						<p>
							Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten (Texte, Bildmaterial, Fotografien und Grafiken) unterliegen dem deutschen Urheberrecht. Die Vervielfältigung, Bearbeitung, Verbreitung und jede Art der Verwertung außerhalb der Grenzen des Urheberrechtes bedürfen der schriftlichen Zustimmung des jeweiligen Autors bzw. Erstellers.
						</p>
					</section>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
