---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const offenDenkenHref = `${baseUrl}/offen-denken/`;
---

<Layout
	title="Martin Bendl — Mensch. Heimat. Geschichten."
	description="Martin Bendl: Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause. Verwitwet und alleinerziehender Vater."
>
	<Header />

	<main class="w-full">
		<!-- ===== HERO SECTION ===== -->
		<section class="relative mx-auto flex min-h-[100vh] w-full items-center overflow-hidden pt-20 max-md:min-h-[calc(100vh-2rem)]">
			<div
				class="absolute inset-0 bg-[image:var(--hero-image)] bg-left-top bg-no-repeat bg-cover max-md:bg-[image:linear-gradient(to_bottom,transparent_25%,var(--color-warm-bg)_42%),var(--hero-image)] max-md:bg-[position:center,8%_5rem] max-md:bg-[length:100%_100%,auto_60vh] min-[640px]:max-md:bg-[length:100%_100%,100%_auto] max-md:bg-no-repeat max-md:bg-[var(--color-warm-bg)] min-[1536px]:bg-left-top"
				style={`--hero-image: url("${baseUrl}/martin-bendl-hero-background.png?v=1")`}
				role="img"
				aria-label="Martin Bendl in einer Landschaft des Bayerischen Waldes"
			></div>

			<!-- Hero text content (right side on desktop) -->
			<div class="relative z-10 mt-auto flex w-full flex-col justify-start self-stretch px-6 py-12 md:mt-0 md:ml-[40%] md:w-[60%] md:py-0 lg:px-12 xl:px-16 max-md:ml-0 max-md:pt-[40vh]">
				<div class="max-w-xl">
					<h1 class="hero-title text-5xl sm:text-6xl md:text-6.5xl lg:text-7xl xl:text-8xl font-sans font-bold text-[var(--color-text-primary)] leading-[0.98] tracking-tight mb-6 md:mb-6">
						<span class="block">Mensch.</span>
						<span class="block">Heimat.</span>
						<span class="relative block w-fit">Geschichten.<svg class="absolute right-0 bottom-[-0.12em] h-[0.14em] w-[76%] overflow-visible text-[var(--color-olive)]" viewBox="0 0 300 18" fill="none" aria-hidden="true">
							<path d="M3 13C79 1 199 1 297 12" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
						</svg></span>
					</h1>
					<p class="text-base font-medium sm:text-lg md:text-lg lg:text-xl text-[#050300] leading-[1.2] mb-5 md:mb-5 max-w-xl">
						Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause. Papa, Freund, Podcaster, Hobbyfotograf und derjenige, der gerne ein bisschen genauer hinhört.
					</p>

					<!-- CTA Button -->
					<a
						href="#meine-geschichte"
						class="inline-flex origin-center items-center gap-3 px-7 py-2.5 bg-[var(--color-olive)] text-white rounded-full text-base font-medium hover:bg-[var(--color-olive-dark)] transition-all duration-300 shadow-lg shadow-[var(--color-olive)]/20 hover:shadow-xl hover:shadow-[var(--color-olive)]/30 hover:-translate-y-0.5 hover:scale-[1.08] focus-visible:scale-[1.05]"
					>
						Meine Geschichte entdecken
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
				</div>

				<!-- Dock Buttons Row -->
				<div class="mt-8 md:mt-[5%]">
					<nav id="dock" class="relative flex items-center justify-start gap-x-3 max-[1100px]:flex-wrap max-[1100px]:gap-y-4 min-[1024px]:max-[1100px]:flex-nowrap min-[1024px]:max-[1100px]:gap-x-3" aria-label="Martin Bendl online">
						<!-- Unter uns g'sogt (Podcast) -->
						<span class="inline-flex items-center gap-3">
							<a
								href="https://unter-uns-gsogt.podigee.io"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Unter uns g'sogt Podcast öffnen"
								class="inline-flex items-center gap-[0.55rem] whitespace-nowrap py-[0.2rem] text-[0.8125rem] font-medium text-white [text-shadow:0_1px_5px_rgb(22_37_10_/_48%)] [transform-origin:center] transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] focus-visible:scale-[1.2] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 max-md:text-[var(--color-text-primary)] max-md:[text-shadow:none] max-md:focus-visible:outline-[var(--color-olive)]"
							>
								<span class="inline-flex h-[1.8rem] w-[1.8rem] flex-[0_0_1.8rem] items-center justify-center rounded-full bg-[var(--color-olive)] text-white outline outline-1 outline-white/40 outline-offset-1" aria-hidden="true">
									<svg class="h-[1.2rem] w-[1.2rem]" viewBox="0 0 24 24" fill="none">
										<rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M6.5 11a5.5 5.5 0 0 0 11 0M12 16.5V21m-3 0h6" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<span class="relative pb-[0.3rem] font-medium italic">Unter uns g'sogt<svg class="absolute right-0 bottom-0 h-[0.45rem] w-full overflow-visible" viewBox="0 0 112 8" aria-hidden="true"><path d="M2 5c28-5 72-4 108 0" class="fill-none stroke-[#c5cb23] stroke-[2.5] stroke-linecap-round" /></svg></span>
							</a>
							<span class="dock-divider h-[1.65rem] w-px flex-[0_0_1px] bg-white/75 transition-opacity duration-[180ms] max-md:bg-[var(--color-olive)]" aria-hidden="true"></span>
						</span>

						<!-- @woidstrawanza (Instagram) -->
						<span class="inline-flex items-center gap-3">
							<a
								href="https://www.instagram.com/woidstrawanza"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Instagram-Profil @woidstrawanza öffnen"
								class="inline-flex items-center gap-[0.55rem] whitespace-nowrap py-[0.2rem] text-[0.8125rem] font-medium text-white [text-shadow:0_1px_5px_rgb(22_37_10_/_48%)] [transform-origin:center] transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] focus-visible:scale-[1.2] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 max-md:text-[var(--color-text-primary)] max-md:[text-shadow:none] max-md:focus-visible:outline-[var(--color-olive)]"
							>
								<span class="inline-flex h-[1.8rem] w-[1.8rem] flex-[0_0_1.8rem] items-center justify-center rounded-full border border-[#9db53f] bg-[var(--color-olive)] text-white" aria-hidden="true">
									<svg class="w-8 h-5" viewBox="0 0 24 24" fill="none">
										<rect x="3.5" y="3.5" width="17" height="17" rx="4" class="fill-none stroke-current stroke-[1.7]" />
										<circle cx="12" cy="12" r="4" class="fill-none stroke-current stroke-[1.7]" />
										<circle cx="17.5" cy="6.8" r="1" class="fill-current stroke-none" />
									</svg>
								</span>
								<span class="relative pb-[0.3rem] font-medium italic">@woidstrawanza<svg class="absolute right-0 bottom-0 h-[0.45rem] w-full overflow-visible" viewBox="0 0 112 8" aria-hidden="true"><path d="M2 5c28-5 72-4 108 0" class="fill-none stroke-[#c5cb23] stroke-[2.5] stroke-linecap-round" /></svg></span>
							</a>
							<span class="dock-divider h-[1.65rem] w-px flex-[0_0_1px] bg-white/75 transition-opacity duration-[180ms] max-md:bg-[var(--color-olive)]" aria-hidden="true"></span>
						</span>

						<!-- @herz.ensmenschen (Instagram) -->
						<a
							href="https://www.instagram.com/herz.ensmenschen"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Instagram-Profil @herz.ensmenschen öffnen"
							class="inline-flex items-center gap-[0.55rem] whitespace-nowrap py-[0.2rem] text-[0.8125rem] font-medium text-white [text-shadow:0_1px_5px_rgb(22_37_10_/_48%)] [transform-origin:center] transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] focus-visible:scale-[1.2] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 max-md:text-[var(--color-text-primary)] max-md:[text-shadow:none] max-md:focus-visible:outline-[var(--color-olive)]"
						>
							<span class="inline-flex h-[1.8rem] w-[1.8rem] flex-[0_0_1.8rem] items-center justify-center rounded-full border border-[#9db53f] bg-[var(--color-olive)] text-white" aria-hidden="true">
								<svg class="w-8 h-5" viewBox="0 0 24 24" fill="none">
									<rect x="3.5" y="3.5" width="17" height="17" rx="4" class="fill-none stroke-current stroke-[1.7]" />
									<circle cx="12" cy="12" r="4" class="fill-none stroke-current stroke-[1.7]" />
									<circle cx="17.5" cy="6.8" r="1" class="fill-current stroke-none" />
								</svg>
							</span>
							<span class="relative pb-[0.3rem] font-medium italic">@herz.ensmenschen<svg class="absolute right-0 bottom-0 h-[0.45rem] w-full overflow-visible" viewBox="0 0 112 8" aria-hidden="true"><path d="M2 5c28-5 72-4 108 0" class="fill-none stroke-[#c5cb23] stroke-[2.5] stroke-linecap-round" /></svg></span>
						</a>
					</nav>
				</div>
			</div>
		</section>

		<!-- ===== OFFEN DENKEN CARD (overlapping hero bottom) ===== -->
		<section class="relative z-20 -mt-8 md:-mt-50 pb-17">
			<div class="mx-auto w-[calc(100%-3rem)] max-w-[1220px] min-[1024px]:ml-10 min-[1024px]:mr-6 min-[1024px]:w-[calc(100%-4rem)] min-[1280px]:mx-auto min-[1280px]:w-[calc(100%-5rem)]">
				<div class="bg-[#fff5eb] rounded-2xl shadow-xl shadow-black/5 border border-[var(--color-border-soft)] p-8 md:pl-10 md:pr-0 md:pt-5 md:pb-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
					<div class="max-w-[43rem] min-[1536px]:max-w-[55rem]">
						<p class="text-xs uppercase tracking-[0.2em] text-[var(--color-olive)] font-semibold mb-2">
							Offen Denken
						</p>
						<h2 class="text-2xl sm:text-3xl md:text-[1.75rem] font-sans font-bold text-[var(--color-text-primary)] leading-tight mb-2">
							Raum für Gedanken, die sonst keinen Platz finden.
						</h2>
						<h3 class="text-[1.4rem] font-bold text-[#686057]">
							Persönliches Sparring für emotionale Klarheit.
						</h3>
						<p class="text-sm md:text-base text-[var(--color-text-secondary)] leading-relaxed">
							Vielleicht brauchst du keine Antwort. Sondern jemanden, bei dem du endlich ehrlich denken kannst.
						</p>
					</div>
					<a
						href={offenDenkenHref}
						class="inline-flex self-end origin-center w-[280px] max-w-[280px] shrink-0 items-center justify-between gap-3 px-6 py-4 bg-[var(--color-olive)] text-white rounded-full text-base font-medium leading-tight hover:bg-[var(--color-olive-dark)] transition-all duration-300 shadow-lg shadow-[var(--color-olive)]/20 hover:shadow-xl hover:shadow-[var(--color-olive)]/30 hover:-translate-y-0.5 hover:scale-[1.08] focus-visible:scale-[1.05] md:-translate-x-4"
					>
						Offen Denken entdecken
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ===== MEINE GESCHICHTE SECTION ===== -->
		<section id="meine-geschichte-old" class="hidden py-16 md:py-24">
			<div class="max-w-4xl mx-auto px-6 lg:px-10">
				<p class="text-xs uppercase tracking-[0.2em] text-[var(--color-olive)] font-semibold mb-3">
					Über mich
				</p>
				<h2 class="text-3xl md:text-4xl font-serif font-bold text-[var(--color-text-primary)] tracking-tight mb-8">
					Meine Geschichte
				</h2>
				<div class="max-w-2xl space-y-5 text-base leading-relaxed text-[var(--color-text-secondary)] md:text-lg">
					<p>
						Ich bin Martin Bendl. Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause. Verwitwet, alleinerziehender Vater und ein Mensch, dessen Geschichte einige ungeplante Wendungen genommen hat.
					</p>
					<p class="font-semibold text-[var(--color-olive-dark)]">
						Mittendrin meine Tochter. Ihre Kindheit findet jetzt statt.
					</p>
					<a
						href={`${baseUrl}/meine-geschichte/`}
						class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-olive)] underline underline-offset-4 hover:text-[var(--color-olive-dark)]"
					>
						Mehr über meine Geschichte
						<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ===== CONTINUING STORY SECTION ===== -->
		<section id="meine-geschichte" class="py-16 md:py-24">
			<div class="max-w-3xl mx-auto px-6 text-center space-y-6">
				<h2 class="text-2xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] md:text-3xl">
					Meine eigene Geschichte schreibe ich weiter.
				</h2>
				<p class="text-sm text-[var(--color-text-secondary)]">
					Als Papa. Als Freund. Als Waidler vom Woid.
				</p>
				<p class="text-sm text-[var(--color-text-secondary)]">
					Mit Ideen, Fragen, Umwegen und der Lust, Neues auszuprobieren.
				</p>
				<div class="pt-4">
					<a
						href={`${baseUrl}/meine-geschichte/`}
						class="inline-flex items-center gap-3 px-7 py-3.5 border-2 border-[var(--color-olive)] text-[var(--color-olive)] rounded-full text-base font-medium hover:bg-[var(--color-olive)] hover:text-white transition-all duration-300"
					>
						<span>Meine Geschichte</span>
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
	</Layout>

<style>
	#dock:has(> span:first-child > a:is(:hover, :focus)) > span:first-child .dock-divider,
	#dock:has(> a:last-child:is(:hover, :focus)) > span:nth-child(2) .dock-divider {
		opacity: 0;
	}

	#dock:has(> span:nth-child(2) > a:is(:hover, :focus)) .dock-divider {
		opacity: 0;
	}
</style>
