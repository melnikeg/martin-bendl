---
---

<footer id="kontakt" class="bg-[#1d2633] text-[#deded9] border-t border-[#293649] pt-16 pb-12 transition-colors">
	<div class="max-w-6xl mx-auto px-6">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-[#293649]">
			<!-- Brand statement / Quote -->
			<div class="md:col-span-5 space-y-4">
				<h3 class="text-2xl font-serif text-white tracking-tight">
					Martin Bendl
				</h3>
				<p class="text-sm text-[#b2b5ba] leading-relaxed max-w-sm">
					Du brauchst keine fertigen Ratschläge – du brauchst einen echten Dialog. Für mehr Klarheit im Alltag, im Gespräch und in der Bewegung.
				</p>
				<div class="pt-2">
					<a
						href="mailto:kontakt@martin-bendl.de"
						class="text-sm text-white underline underline-offset-4 hover:text-[#93c5fd] transition-colors"
					>
						kontakt@martin-bendl.de
					</a>
				</div>
			</div>

			<!-- Navigation & Projects (Podcast & Walk & Talk) -->
			<div class="md:col-span-4 space-y-3">
				<p class="text-xs uppercase tracking-widest text-[#8a919e] font-semibold">
					Themen & Angebote
				</p>
				<ul class="space-y-2 text-sm">
					<li>
						<a href="#podcast" class="hover:text-white transition-colors flex items-center gap-2">
							<span class="text-emerald-400">🎙️</span>
							<span>Podcast (Bayerischer Dialekt)</span>
						</a>
					</li>
					<li>
						<a href="#walk-and-talk" class="hover:text-white transition-colors flex items-center gap-2">
							<span class="text-emerald-400">🚶</span>
							<span>Walk & Talk – Psychologische Beratung</span>
						</a>
					</li>
					<li>
						<a href="#ueber-mich" class="hover:text-white transition-colors">
							Über Martin Bendl
						</a>
					</li>
				</ul>
			</div>

			<!-- Social Links (Instagram, Facebook) & Meta -->
			<div class="md:col-span-3 space-y-3">
				<p class="text-xs uppercase tracking-widest text-[#8a919e] font-semibold">
					Social Media & Kontakt
				</p>
				<div class="flex items-center gap-4 pt-1">
					<!-- Instagram -->
					<a
						href="https://instagram.com/martin.bendl"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Martin Bendl auf Instagram"
						class="w-10 h-10 rounded-full border border-[#3b495d] flex items-center justify-center text-white hover:bg-white hover:text-[#1d2633] transition-all"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
						</svg>
					</a>

					<!-- Facebook -->
					<a
						href="https://facebook.com/martin.bendl"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Martin Bendl auf Facebook"
						class="w-10 h-10 rounded-full border border-[#3b495d] flex items-center justify-center text-white hover:bg-white hover:text-[#1d2633] transition-all"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"></path>
						</svg>
					</a>
				</div>
				<p class="text-xs text-[#8a919e] pt-2">
					Folgen Sie mir für aktuelle Episoden und Impulse.
				</p>
			</div>
		</div>

		<!-- Bottom Copyright & Legal Links (as in kvd sample) -->
		<div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#8a919e] gap-4">
			<p>&copy; {new Date().getFullYear()} Martin Bendl. Alle Rechte vorbehalten.</p>
			<div class="flex items-center gap-6">
				<a href="#impressum" class="hover:text-white transition-colors">Impressum</a>
				<span class="text-[#3b495d]">&bull;</span>
				<a href="#datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
			</div>
		</div>
	</div>
</footer>
