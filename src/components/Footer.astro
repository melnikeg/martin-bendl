---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const offenDenkenHref = `${baseUrl}/offen-denken/`;
---

<footer id="kontakt" class="relative z-10 bg-[var(--color-oliv-dunk)] text-white/90 pt-8 pb-6">
	<div class="max-w-7xl mx-auto px-6 lg:px-10">
		<div class="grid grid-cols-1 gap-10 border-b border-white/15 pb-6 md:grid-cols-12 md:gap-8">
			<!-- Brand statement -->
			<div class="space-y-4 md:col-span-4">
				<div class="flex items-center gap-2.5">
					<img src={`${baseUrl}/wald-logo-footer.svg`} class="w-40 h-25 object-contain" alt="" aria-hidden="true" />
					<h3 class="text-2xl font-serif text-white tracking-tight">
						Martin Bendl
					</h3>
				</div>
				<p class="text-sm text-white/60 leading-relaxed max-w-sm">
					Im Herzen des Bayerischen Waldes geboren, aufgewachsen und bis heute zu Hause.
				</p>
			</div>

			<!-- Navigation & Projects -->
			<div class="space-y-5 md:col-span-4">
				<p class="text-center text-xs uppercase tracking-widest text-white/40 font-semibold">
					Entdecken
				</p>
				<ul class="grid grid-rows-2 gap-y-5">
					<li>
						<a
							href="https://unter-uns-gsogt.podigee.io"
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex origin-center items-center gap-4 text-white/75 transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] hover:text-white focus-visible:scale-[1.2] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
						>
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/40 text-white/85 transition-colors group-hover:border-white group-hover:bg-white/10" aria-hidden="true">
								<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none">
									<rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
									<path d="M6.5 11a5.5 5.5 0 0 0 11 0M12 16.5V21m-3 0h6" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<span class="text-lg font-medium leading-tight">Unter uns<br />g'sogt</span>
						</a>
					</li>
					<li>
						<a
							href={offenDenkenHref}
							class="group inline-flex origin-center items-center gap-4 text-white/75 transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] hover:text-white focus-visible:scale-[1.2] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
						>
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#f8f2e7] text-[var(--color-oliv-dunk)]" aria-hidden="true">
								<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none">
									<path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.9L4 21l4.7-1.6A8.5 8.5 0 1 0 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<span class="text-lg font-medium leading-tight">Offen Denken</span>
						</a>
					</li>
				</ul>
			</div>

			<!-- Social Links -->
			<div class="space-y-5 md:col-span-4">
				<p class="text-center text-xs uppercase tracking-widest text-white/40 font-semibold">
					Social Media
				</p>
				<div class="grid grid-cols-2 gap-x-3 gap-y-5">
					<a
						href="https://www.instagram.com/unter_uns_gsogt"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Unter uns g'sogt auf Instagram"
						class="group flex w-32 max-w-full min-w-0 origin-center justify-self-center flex-col items-center gap-2 text-center text-white/70 transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] hover:text-white focus-visible:scale-[1.2] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
					>
						<span class="flex h-14 w-14 items-center justify-center rounded-full border border-white/35 transition-colors group-hover:border-white group-hover:bg-white/10" aria-hidden="true">
							<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
							</svg>
						</span>
						<span class="text-sm leading-tight">Podcast</span>
					</a>

					<!-- Instagram -->
					<a
						href="https://www.instagram.com/woidstrawanza"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Martin Bendl (@woidstrawanza) auf Instagram"
						class="group flex w-32 max-w-full min-w-0 origin-center justify-self-center flex-col items-center gap-2 text-center text-white/70 transition-transform duration-[180ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.2] hover:text-white focus-visible:scale-[1.2] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
					>
						<span class="flex h-14 w-14 items-center justify-center rounded-full border border-white/35 transition-colors group-hover:border-white group-hover:bg-white/10" aria-hidden="true">
							<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
