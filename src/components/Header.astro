---
---

<header class="sticky top-0 z-50 bg-[#fbfbfa]/90 backdrop-blur-md border-b border-[#e7e5e0] transition-colors duration-200">
	<div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
		<!-- Brand / Logo -->
		<a href={import.meta.env.BASE_URL} class="group flex flex-col">
			<span class="text-xl md:text-2xl font-semibold tracking-tight text-[#1c1c1a] group-hover:text-[#253243] transition-colors font-serif">
				Martin Bendl
			</span>
			<span class="text-[10px] uppercase tracking-widest text-[#787672] font-medium">
				Dialog &middot; Podcast &middot; Beratung
			</span>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden md:flex items-center gap-8 text-sm">
			<a href="#ueber-mich" class="text-[#4a4946] hover:text-[#1c1c1a] transition-colors font-medium">
				Über mich
			</a>
			<a href="#podcast" class="text-[#4a4946] hover:text-[#1c1c1a] transition-colors font-medium flex items-center gap-1.5">
				<span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
				Podcast
			</a>
			<a href="#walk-and-talk" class="text-[#4a4946] hover:text-[#1c1c1a] transition-colors font-medium">
				Walk & Talk Beratung
			</a>
			<a href="#kontakt" class="text-[#4a4946] hover:text-[#1c1c1a] transition-colors font-medium">
				Kontakt
			</a>
		</nav>

		<!-- Desktop Action CTA -->
		<div class="hidden sm:flex items-center gap-3">
			<a
				href="http://offendenken.de/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs uppercase tracking-wider font-semibold px-4 py-2.5 rounded-none border border-[#1d2633] text-[#1d2633] hover:bg-[#1d2633] hover:text-white transition-all duration-200"
			>
				Termin anfragen
			</a>
		</div>

		<!-- Animated Mobile Burger Button -->
		<button
			id="mobile-menu-btn"
			type="button"
			class="md:hidden relative w-10 h-10 flex flex-col justify-center items-center gap-1.5 focus:outline-none group p-2 -mr-2"
			aria-label="Menü öffnen"
			aria-expanded="false"
		>
			<span id="burger-top" class="w-6 h-[1.5px] bg-[#1c1c1a] transition-all duration-300 ease-in-out origin-center"></span>
			<span id="burger-mid" class="w-6 h-[1.5px] bg-[#1c1c1a] transition-all duration-300 ease-in-out origin-center"></span>
			<span id="burger-bot" class="w-6 h-[1.5px] bg-[#1c1c1a] transition-all duration-300 ease-in-out origin-center"></span>
		</button>
	</div>

	<!-- Mobile Overlay & Floating Dropdown Panel (Positioned on top of content, not pushing down) -->
	<div
		id="mobile-menu-backdrop"
		class="fixed inset-0 top-20 z-40 bg-black/35 backdrop-blur-xs md:hidden opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
	>
		<div
			id="mobile-menu-panel"
			class="bg-[#fbfbfa] border-b border-[#e7e5e0] px-6 pt-5 pb-8 shadow-2xl transform -translate-y-4 opacity-0 transition-all duration-300 ease-out"
		>
			<nav class="flex flex-col space-y-1">
				<a
					href="#ueber-mich"
					class="mobile-link text-base font-medium text-[#1c1c1a] py-3 border-b border-[#e7e5e0]/70 flex items-center justify-between hover:text-[#253243] transition-colors"
				>
					<span>Über mich</span>
					<span class="text-xs text-[#787672] font-mono">01</span>
				</a>
				<a
					href="#podcast"
					class="mobile-link text-base font-medium text-[#1c1c1a] py-3 border-b border-[#e7e5e0]/70 flex items-center justify-between hover:text-[#253243] transition-colors"
				>
					<span class="flex items-center gap-2">
						<span class="text-emerald-600">🎙️</span>
						<span>Podcast (Bayerischer Dialekt)</span>
					</span>
					<span class="text-xs text-[#787672] font-mono">02</span>
				</a>
				<a
					href="#walk-and-talk"
					class="mobile-link text-base font-medium text-[#1c1c1a] py-3 border-b border-[#e7e5e0]/70 flex items-center justify-between hover:text-[#253243] transition-colors"
				>
					<span class="flex items-center gap-2">
						<span class="text-emerald-600">🚶</span>
						<span>Walk & Talk Beratung</span>
					</span>
					<span class="text-xs text-[#787672] font-mono">03</span>
				</a>
				<a
					href="#kontakt"
					class="mobile-link text-base font-medium text-[#1c1c1a] py-3 border-b border-[#e7e5e0]/70 flex items-center justify-between hover:text-[#253243] transition-colors"
				>
					<span>Kontakt &amp; Impressum</span>
					<span class="text-xs text-[#787672] font-mono">04</span>
				</a>

				<div class="pt-5">
					<a
						href="http://offendenken.de/"
						target="_blank"
						rel="noopener noreferrer"
						class="mobile-link block text-center text-xs uppercase tracking-widest font-semibold px-5 py-3.5 bg-[#1d2633] text-white hover:bg-[#2c384a] active:bg-[#141b25] transition-colors"
					>
						Termin anfragen
					</a>
				</div>
			</nav>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const backdrop = document.getElementById('mobile-menu-backdrop');
	const panel = document.getElementById('mobile-menu-panel');
	const lineTop = document.getElementById('burger-top');
	const lineMid = document.getElementById('burger-mid');
	const lineBot = document.getElementById('burger-bot');
	const links = document.querySelectorAll('.mobile-link');

	let isOpen = false;

	function openMenu() {
		isOpen = true;
		btn?.setAttribute('aria-expanded', 'true');
		btn?.setAttribute('aria-label', 'Menü schließen');

		// Backdrop animation
		backdrop?.classList.remove('opacity-0', 'pointer-events-none');
		backdrop?.classList.add('opacity-100', 'pointer-events-auto');

		// Panel slide-down animation
		panel?.classList.remove('-translate-y-4', 'opacity-0');
		panel?.classList.add('translate-y-0', 'opacity-100');

		// Burger to X animation
		lineTop?.classList.add('rotate-45', 'translate-y-[7.5px]');
		lineMid?.classList.add('opacity-0', 'scale-x-0');
		lineBot?.classList.add('-rotate-45', '-translate-y-[7.5px]');

		// Lock body scroll
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		isOpen = false;
		btn?.setAttribute('aria-expanded', 'false');
		btn?.setAttribute('aria-label', 'Menü öffnen');

		// Backdrop animation
		backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
		backdrop?.classList.add('opacity-0', 'pointer-events-none');

		// Panel slide-up animation
		panel?.classList.remove('translate-y-0', 'opacity-100');
		panel?.classList.add('-translate-y-4', 'opacity-0');

		// X back to burger animation
		lineTop?.classList.remove('rotate-45', 'translate-y-[7.5px]');
		lineMid?.classList.remove('opacity-0', 'scale-x-0');
		lineBot?.classList.remove('-rotate-45', '-translate-y-[7.5px]');

		// Unlock body scroll
		document.body.style.overflow = '';
	}

	function toggleMenu() {
		if (isOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	}

	btn?.addEventListener('click', toggleMenu);

	// Close when clicking outside on the backdrop
	backdrop?.addEventListener('click', (e) => {
		if (e.target === backdrop) {
			closeMenu();
		}
	});

	// Close when clicking any menu link
	links.forEach((l) => {
		l.addEventListener('click', () => {
			closeMenu();
		});
	});

	// Close on Escape key
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) {
			closeMenu();
		}
	});
</script>
