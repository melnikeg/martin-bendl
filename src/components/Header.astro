---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${baseUrl}/`;
const storyHref = `${baseUrl}/meine-geschichte/`;
const contactHref = `${homeHref}#kontakt`;
const isStoryPage = Astro.url.pathname.replace(/\/$/, '') === `${baseUrl}/meine-geschichte`;
const storyLinkClass = isStoryPage
	? 'text-[var(--color-olive)] underline decoration-[var(--color-olive)]/50 underline-offset-8'
	: 'text-[var(--color-text-primary)] hover:text-[var(--color-olive)]';
const brandClass = 'text-[1.15rem] font-semibold tracking-tight text-[var(--color-text-primary)] group-hover:text-[var(--color-olive)] transition-colors';
---

<header
	class:list={[
		'fixed top-0 left-0 right-0 z-50 h-20 transition-[background-color,backdrop-filter,box-shadow] duration-300 md:h-14',
		isStoryPage
			? 'bg-[var(--color-warm-bg)] backdrop-blur-md shadow-sm'
			: 'bg-transparent max-md:bg-[var(--color-warm-bg)]',
	]}
	data-story-page={isStoryPage ? 'true' : undefined}
	id="site-header"
>
	<div class="max-w-[1280px] mx-auto px-6 lg:pl-28 lg:pr-3.5 h-full flex items-center justify-between">
		<!-- Brand / Logo with mountain SVG -->
		<a href={homeHref} class="group flex items-center gap-3">
			<img src={`${baseUrl}/berg.svg`} class="w-16 h-6 object-contain" alt="" aria-hidden="true" />
			<span class="h-7 border-l border-[var(--color-text-primary)]/30" aria-hidden="true"></span>
			<span class={brandClass}>Martin Bendl</span>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
			<a href={storyHref} aria-current={isStoryPage ? 'page' : undefined} class:list={[storyLinkClass, 'transition-colors']}>
				Meine Geschichte
			</a>
			<a href="http://offendenken.de/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-primary)] hover:text-[var(--color-olive)] transition-colors">
				Offen Denken
			</a>
			<a href="https://unter-uns-gsogt.podigee.io" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-primary)] hover:text-[var(--color-olive)] transition-colors">
				Podcast
			</a>
			<a href={contactHref} class="text-[var(--color-text-primary)] hover:text-[var(--color-olive)] transition-colors">
				Kontakt
			</a>
		</nav>

		<!-- Animated Mobile Burger Button -->
		<button
			id="mobile-menu-btn"
			type="button"
			class="md:hidden relative w-10 h-10 flex flex-col justify-center items-center gap-1.5 focus:outline-none group p-2 -mr-2"
			aria-label="Menü öffnen"
			aria-expanded="false"
		>
			<span id="burger-top" class="w-6 h-[1.5px] bg-[var(--color-text-primary)] transition-all duration-300 ease-in-out origin-center"></span>
			<span id="burger-mid" class="w-6 h-[1.5px] bg-[var(--color-text-primary)] transition-all duration-300 ease-in-out origin-center"></span>
			<span id="burger-bot" class="w-6 h-[1.5px] bg-[var(--color-text-primary)] transition-all duration-300 ease-in-out origin-center"></span>
		</button>
	</div>

	<!-- Mobile Overlay & Floating Dropdown Panel -->
	<div
		id="mobile-menu-backdrop"
		class="fixed inset-0 top-20 z-40 bg-black/35 backdrop-blur-xs md:hidden opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
	>
		<div
			id="mobile-menu-panel"
			class="bg-[var(--color-warm-bg)] border-b border-[var(--color-border-soft)] px-6 pt-5 pb-8 shadow-2xl transform -translate-y-4 opacity-0 transition-all duration-300 ease-out"
		>
			<nav class="flex flex-col space-y-1">
				<a
					href={storyHref}
					aria-current={isStoryPage ? 'page' : undefined}
					class:list={['mobile-link border-b border-[var(--color-border-soft)]/70 py-3 text-base font-medium transition-colors hover:text-[var(--color-olive)]', storyLinkClass]}
				>
					Meine Geschichte
				</a>
				<a
					href="http://offendenken.de/"
					target="_blank"
					rel="noopener noreferrer"
					class="mobile-link text-base font-medium text-[var(--color-text-primary)] py-3 border-b border-[var(--color-border-soft)]/70 hover:text-[var(--color-olive)] transition-colors"
				>
					Offen Denken
				</a>
				<a
					href="https://unter-uns-gsogt.podigee.io"
					target="_blank"
					rel="noopener noreferrer"
					class="mobile-link text-base font-medium text-[var(--color-text-primary)] py-3 border-b border-[var(--color-border-soft)]/70 hover:text-[var(--color-olive)] transition-colors"
				>
					Podcast
				</a>
				<a
					href={contactHref}
					class="mobile-link text-base font-medium text-[var(--color-text-primary)] py-3 border-b border-[var(--color-border-soft)]/70 hover:text-[var(--color-olive)] transition-colors"
				>
					Kontakt
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const backdrop = document.getElementById('mobile-menu-backdrop');
	const panel = document.getElementById('mobile-menu-panel');
	const lineTop = document.getElementById('burger-top');
	const lineMid = document.getElementById('burger-mid');
	const lineBot = document.getElementById('burger-bot');
	const links = document.querySelectorAll('.mobile-link');

	const header = document.getElementById('site-header');
	const isStoryPage = header?.dataset.storyPage === 'true';
	let isOpen = false;
	const isMobileViewport = () => window.matchMedia('(max-width: 767px)').matches;
	let headerBackgroundClass = isStoryPage || isMobileViewport()
		? 'bg-[var(--color-warm-bg)]'
		: 'bg-transparent';
	let bodyOverflowBeforeMenu = '';

	const headerBackgroundClasses = ['bg-transparent', 'bg-[var(--color-warm-bg)]', 'bg-[var(--color-warm-bg)]/90'];

	function updateHeaderAppearance() {
		const isScrolled = window.scrollY > 50;
		const hasFixedBackground = isOpen || isStoryPage || isMobileViewport();
		const nextBackgroundClass = hasFixedBackground
			? 'bg-[var(--color-warm-bg)]'
			: isScrolled
				? 'bg-[var(--color-warm-bg)]/90'
				: 'bg-transparent';

		if (headerBackgroundClass !== nextBackgroundClass) {
			header?.classList.remove(...headerBackgroundClasses);
			header?.classList.add(nextBackgroundClass);
			headerBackgroundClass = nextBackgroundClass;
		}

		header?.classList.toggle('backdrop-blur-md', hasFixedBackground || isScrolled);
		header?.classList.toggle('shadow-sm', hasFixedBackground || isScrolled);
		header?.classList.toggle('transition-none', isOpen);
	}

	function openMenu() {
		isOpen = true;
		btn?.setAttribute('aria-expanded', 'true');
		btn?.setAttribute('aria-label', 'Menü schließen');
		updateHeaderAppearance();

		backdrop?.classList.remove('opacity-0', 'pointer-events-none');
		backdrop?.classList.add('opacity-100', 'pointer-events-auto');

		panel?.classList.remove('-translate-y-4', 'opacity-0');
		panel?.classList.add('translate-y-0', 'opacity-100');

		lineTop?.classList.add('rotate-45', 'translate-y-[7.5px]');
		lineMid?.classList.add('opacity-0', 'scale-x-0');
		lineBot?.classList.add('-rotate-45', '-translate-y-[7.5px]');

		bodyOverflowBeforeMenu = document.body.style.overflow;
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		isOpen = false;
		btn?.setAttribute('aria-expanded', 'false');
		btn?.setAttribute('aria-label', 'Menü öffnen');
		updateHeaderAppearance();

		backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
		backdrop?.classList.add('opacity-0', 'pointer-events-none');

		panel?.classList.remove('translate-y-0', 'opacity-100');
		panel?.classList.add('-translate-y-4', 'opacity-0');

		lineTop?.classList.remove('rotate-45', 'translate-y-[7.5px]');
		lineMid?.classList.remove('opacity-0', 'scale-x-0');
		lineBot?.classList.remove('-rotate-45', '-translate-y-[7.5px]');

		document.body.style.overflow = bodyOverflowBeforeMenu;
	}

	function toggleMenu() {
		if (isOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	}

	btn?.addEventListener('click', toggleMenu);

	backdrop?.addEventListener('click', (e) => {
		if (e.target === backdrop) {
			closeMenu();
		}
	});

	links.forEach((l) => {
		l.addEventListener('click', () => {
			closeMenu();
		});
	});

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) {
			closeMenu();
		}
	});

	window.addEventListener('scroll', () => {
		updateHeaderAppearance();
	}, { passive: true });
	window.addEventListener('resize', updateHeaderAppearance);

	updateHeaderAppearance();
</script>
